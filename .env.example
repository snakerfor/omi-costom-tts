# Required
SONIOX_API_KEY=your_soniox_api_key_here
ACCESS_TOKENS=token-device-a,token-device-b

# Optional
PORT=8080
NODE_ENV=production
SONIOX_LANGUAGE_HINTS=zh,en
OMI_SYNC_TOKEN=change_me
OMI_SYNC_VIDEO_ROOT=./data/omi-videos
STREAM_VAD_MODE=shadow
STREAM_VAD_RMS_THRESHOLD=0.015
STREAM_VAD_PEAK_THRESHOLD=0.055
STREAM_VAD_PRE_ROLL_MS=300
STREAM_VAD_HANGOVER_MS=2200
STREAM_SILENCE_FINALIZE_MS=0
STREAM_NO_AUDIO_FINALIZE_MS=0
STREAM_IDLE_FINALIZE_MS=0

# Speaker matching
SPEAKER_MATCH_THRESHOLD=0.82
