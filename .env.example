# Required
SONIOX_API_KEY=your_soniox_api_key_here
ACCESS_TOKENS=token-device-a,token-device-b

# Optional
PORT=28089
NODE_ENV=production
DATA_ROOT=./runtime-data
DB_PATH=./runtime-data/app.db
# Optional per-directory overrides (defaults derive from DATA_ROOT)
# AUDIO_UPLOADS_DIR=./runtime-data/audio-uploads
# RAW_RESULTS_DIR=./runtime-data/raw_results
# FINALIZED_RESULTS_DIR=./runtime-data/finalized_results
# PREVIEW_RESULTS_DIR=./runtime-data/preview_results
# CLIPS_DIR=./runtime-data/clips
SONIOX_LANGUAGE_HINTS=zh,en
OMI_SYNC_TOKEN=change_me
# OMI_SYNC_VIDEO_ROOT=./runtime-data/omi-videos
STREAM_VAD_MODE=shadow
STREAM_VAD_RMS_THRESHOLD=0.015
STREAM_VAD_PEAK_THRESHOLD=0.055
STREAM_VAD_PRE_ROLL_MS=300
STREAM_VAD_HANGOVER_MS=2200
STREAM_SILENCE_FINALIZE_MS=0
STREAM_NO_AUDIO_FINALIZE_MS=0
STREAM_IDLE_FINALIZE_MS=0

# Speaker alignment (pyannote)
# Set to 'false' to skip pyannote speaker re-alignment and keep Soniox original labels
ENABLE_PYANNOTE_ALIGNMENT=true

# Speaker matching
SPEAKER_MATCH_THRESHOLD=0.82

# XFYUN voiceprint (optional)
XFYUN_VOICEPRINT_ENABLED=false
XFYUN_APP_ID=
XFYUN_API_SECRET=
XFYUN_API_KEY=
XFYUN_GROUP_ID=omi_vp_local
XFYUN_HIT_SCORE_THRESHOLD=50
XFYUN_HIT_MARGIN=8
XFYUN_MIN_SEGMENT_MS=1000
XFYUN_SHORT_SEGMENT_MS=3000
XFYUN_SHORT_HIT_SCORE_THRESHOLD=60
XFYUN_MAX_QUERY_MS=8000
XFYUN_MAX_ENROLLMENT_BYTES=4000000

# Knowledge Layer AI (optional — enables AI summaries, memory extraction, ask)
# Auto-reads from OpenClaw config if installed, or set manually:
# MINIMAX_API_KEY=sk-...
# MINIMAX_MODEL=MiniMax-M2.7-highspeed
