# Copy this file to .env and fill in your values
# cp tests/.env.test .env

# Soniox API Key (required)
SONIOX_API_KEY=your_soniox_api_key_here

# Access tokens for APP authentication (comma separated)
ACCESS_TOKENS=my-token

# Server port
PORT=8080

# Language hints for Soniox
SONIOX_LANGUAGE_HINTS=zh,en
